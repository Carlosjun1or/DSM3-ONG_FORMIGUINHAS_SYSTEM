# Copie este arquivo para .env e preencha com os dados reais.
# Nunca envie o .env ao repositório — ele já está no .gitignore.

# ── Django ───────────────────────────────────────────────────────────────────
# Gere uma chave segura com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# true em desenvolvimento, false em produção
DEBUG=true

# Separados por vírgula. Use * para liberar todos (apenas em dev).
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Banco relacional ─────────────────────────────────────────────────────────
# Deixe em branco para usar SQLite local (padrão em desenvolvimento).
# Preencha com a URL do PostgreSQL (AWS RDS) para produção.
# Formato: postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
DATABASE_URL=

# ── E-mail (recuperação de senha) ────────────────────────────────────────────
# Sem SMTP configurado, o link de redefinição aparece apenas no terminal.
# Para Gmail: ative a verificação em duas etapas e gere uma senha de app em
# https://myaccount.google.com/apppasswords (use a senha de app, não a normal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=seu-endereco@gmail.com
DEFAULT_FROM_EMAIL=seu-endereco@gmail.com
EMAIL_HOST_PASSWORD=senha-de-app-sem-espacos

# ── MongoDB Atlas (persistência poliglota) ───────────────────────────────────
# Cole aqui a connection string completa do seu cluster Atlas.
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USUARIO:SENHA@formiguinhascluster.v0kz7fl.mongodb.net/
MONGODB_DATABASE=formiguinhas_db
# MONGODB_TIMEOUT_MS=5000                       # opcional — padrão 5000 ms
# MONGODB_AUDITORIA_COLECAO=auditoria_eventos   # opcional
# MONGODB_ACOES_COLECAO=acoes                   # opcional
# MONGODB_COMUNICADOS_COLECAO=comunicados       # opcional
# MONGODB_CONDOMINIOS_COLECAO=condominios       # opcional

# ── Amazon S3 (armazenamento de mídia) ───────────────────────────────────────
# Deixe em branco para salvar uploads no disco local (desenvolvimento).
# Preencha para enviar arquivos de mídia direto ao S3 (produção).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=sa-east-1
